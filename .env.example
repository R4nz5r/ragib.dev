# Environment variables
# Copy this file to .env.local and fill in the values.

# The public URL of the site (used for RSS, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://ragib.dev

# Resend API Key (server-only; get from https://resend.com/api-keys)
RESEND_API_KEY=re_123456789

# Resend Audience ID (server-only; get from https://resend.com/audiences)
RESEND_AUDIENCE_ID=789e0123-e456-789a-b012-3456789abcde
# Sender email address using verified domain
RESEND_FROM_EMAIL=Ragib <newsletter@blog.ragibshahrier.com>


# TinaCMS (optional in local dev, required for cloud production at https://app.tina.io)
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Vercel Auto-Draft Bot (GitHub Secrets or .env.local)
# Personal access token with read-only scope for projects: https://vercel.com/account/tokens
VERCEL_API_TOKEN=
# Optional: Vercel Team ID if projects live under a team account
VERCEL_TEAM_ID=
# Free-tier LLM API key: Google Gemini (https://aistudio.google.com/) or Groq (https://console.groq.com/)
GEMINI_API_KEY=
LLM_API_KEY=
GROQ_API_KEY=

